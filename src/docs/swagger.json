{
  "openapi": "3.0.3",
  "info": {
    "title": "Rede Raízes do Nordeste API",
    "version": "1.0.0",
    "description": "API RESTful da Rede de Lanchonetes 'Raízes do Nordeste' desenvolvida para a Atividade Prática de Projeto Multidisciplinar (Trilha Back-End) da UNINTER.\n\nRecursos destacados:\n- **Multicanalidade de Domínio:** Tratamento do campo `canalPedido` (APP, TOTEM, BALCAO, PICKUP, WEB).\n- **Isolamento de Estoque:** Validação atômica e saldo segregado por unidade física.\n- **Gateway Mock:** Simulação desacoplada de pagamentos (Aprovação, Recusa e Timeout).\n- **Segurança & LGPD:** Autenticação Bearer JWT, controle de acesso RBAC, hash Bcrypt e logs de auditoria.\n- **Padrão de Resposta:** Tratamento uniforme de erros conforme RFC 7807.",
    "contact": {
      "name": "Lucas Gabriel",
      "email": "lucas.gabriel@uninter.edu.br",
      "url": "https://github.com/lucasgabriel-uninter/raizes-do-nordeste-api"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Servidor Local de Desenvolvimento"
    }
  ],
  "tags": [
    { "name": "Autenticação", "description": "Endpoints de registro e login com emissão de token JWT" },
    { "name": "Unidades & Cardápio", "description": "Consulta de unidades e catálogo com estoque por loja" },
    { "name": "Produtos", "description": "Consulta ao catálogo mestre de delícias nordestinas" },
    { "name": "Pedidos & Multicanalidade", "description": "Criação de pedidos com canalPedido, listagem e filtros" },
    { "name": "Pagamento Mock", "description": "Integração simulada desacoplada do gateway financeiro" },
    { "name": "Cozinha (KDS)", "description": "Gestão e transição do ciclo de vida dos pedidos" },
    { "name": "Fidelidade & LGPD", "description": "Consulta de saldo e consentimento do titular de dados" },
    { "name": "Auditoria", "description": "Trilha de auditoria indelével de ações sensíveis" }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Cadastra um novo usuário",
        "description": "Registra um usuário com hash seguro de senha (Bcrypt) e aceite mandatório da LGPD.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nome", "email", "senha", "consentimentoLGPD"],
                "properties": {
                  "nome": { "type": "string", "example": "Lucas Gabriel" },
                  "email": { "type": "string", "format": "email", "example": "novo.cliente@exemplo.com" },
                  "senha": { "type": "string", "format": "password", "example": "Senha@123" },
                  "telefone": { "type": "string", "example": "(61) 99999-0000" },
                  "perfil": { "type": "string", "enum": ["CLIENTE", "ATENDENTE", "COZINHA", "ADMIN"], "default": "CLIENTE" },
                  "consentimentoLGPD": { "type": "boolean", "example": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuário criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "accessToken": { "type": "string" },
                    "tokenType": { "type": "string", "example": "Bearer" },
                    "user": { "type": "object" }
                  }
                }
              }
            }
          },
          "409": { "description": "E-mail já cadastrado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } },
          "422": { "description": "Falha na validação dos dados", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Autentica usuário e retorna Bearer JWT",
        "description": "Verifica credenciais e emite token JWT assinado com claims de perfil (role).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "senha"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "cliente@exemplo.com" },
                  "senha": { "type": "string", "format": "password", "example": "Senha@123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsIn..." },
                    "tokenType": { "type": "string", "example": "Bearer" },
                    "expiresIn": { "type": "integer", "example": 28800 },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "integer", "example": 4 },
                        "nome": { "type": "string", "example": "Lucas Gabriel" },
                        "email": { "type": "string", "example": "cliente@exemplo.com" },
                        "perfil": { "type": "string", "example": "CLIENTE" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Credenciais inválidas", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } }
        }
      }
    },
    "/unidades": {
      "get": {
        "tags": ["Unidades & Cardápio"],
        "summary": "Lista todas as unidades ativas da rede",
        "responses": {
          "200": { "description": "Lista de unidades recuperada com sucesso" }
        }
      }
    },
    "/unidades/{id}/produtos": {
      "get": {
        "tags": ["Unidades & Cardápio"],
        "summary": "Consulta cardápio com estoque específico por unidade",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "ID da unidade" }
        ],
        "responses": {
          "200": { "description": "Cardápio e estoque da unidade" },
          "404": { "description": "Unidade não encontrada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } }
        }
      }
    },
    "/pedidos": {
      "post": {
        "tags": ["Pedidos & Multicanalidade"],
        "summary": "Cria um novo pedido (Validação de canalPedido e estoque)",
        "description": "Requisito central da UNINTER: exige campo canalPedido obrigatório (APP, TOTEM, BALCAO, PICKUP, WEB) e reserva atômica de estoque.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["unidadeId", "canalPedido", "itens"],
                "properties": {
                  "unidadeId": { "type": "integer", "example": 1 },
                  "canalPedido": { "type": "string", "enum": ["APP", "TOTEM", "BALCAO", "PICKUP", "WEB"], "example": "TOTEM" },
                  "itens": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["produtoId", "quantidade"],
                      "properties": {
                        "produtoId": { "type": "integer", "example": 1 },
                        "quantidade": { "type": "integer", "example": 2 }
                      }
                    }
                  },
                  "observacoes": { "type": "string", "example": "Sem cebola no cuscuz" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Pedido criado com sucesso em AGUARDANDO_PAGAMENTO" },
          "400": { "description": "Requisição inválida", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } },
          "404": { "description": "Unidade ou Produto não encontrado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } },
          "409": { "description": "Estoque insuficiente para um ou mais itens", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } },
          "422": { "description": "canalPedido inválido ou ausente", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } }
        }
      },
      "get": {
        "tags": ["Pedidos & Multicanalidade"],
        "summary": "Lista pedidos com paginação e filtro por canal",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "canalPedido", "in": "query", "schema": { "type": "string", "enum": ["APP", "TOTEM", "BALCAO", "PICKUP", "WEB"] }, "description": "Filtro por canal de venda" },
          { "name": "status", "in": "query", "schema": { "type": "string" }, "description": "Filtro por status do pedido" },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": { "description": "Lista paginada de pedidos" },
          "401": { "description": "Não autenticado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } }
        }
      }
    },
    "/pedidos/{id}": {
      "get": {
        "tags": ["Pedidos & Multicanalidade"],
        "summary": "Detalhes de um pedido por ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Detalhes do pedido recuperados" },
          "404": { "description": "Pedido não encontrado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } }
        }
      }
    },
    "/pedidos/{id}/pagamento": {
      "post": {
        "tags": ["Pagamento Mock"],
        "summary": "Simula processamento de pagamento desacoplado",
        "description": "Simula a resposta do gateway financeiro (APROVADO, RECUSADO, TIMEOUT). Se aprovado, transiciona para EM_PREPARO.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "formaPagamento": { "type": "string", "enum": ["PIX", "CARTAO_CREDITO", "CARTAO_DEBITO", "DINHEIRO"], "default": "PIX" },
                  "statusSimulado": { "type": "string", "enum": ["APROVADO", "RECUSADO", "TIMEOUT"], "default": "APROVADO" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Pagamento aprovado com sucesso e enviado à cozinha" },
          "400": { "description": "Pagamento recusado pela instituição financeira", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } },
          "404": { "description": "Pedido não encontrado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } },
          "409": { "description": "Status inválido para pagamento", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } },
          "503": { "description": "Falha de conectividade com o gateway mock (Timeout)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } }
        }
      }
    },
    "/pedidos/{id}/status": {
      "patch": {
        "tags": ["Cozinha (KDS)"],
        "summary": "Atualiza o status de produção do pedido (RBAC)",
        "description": "Permitido apenas para COZINHA, ATENDENTE e ADMIN. Clientes comuns recebem 403 Forbidden.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["novoStatus"],
                "properties": {
                  "novoStatus": { "type": "string", "enum": ["AGUARDANDO_PAGAMENTO", "EM_PREPARO", "PRONTO", "ENTREGUE", "CANCELADO"], "example": "PRONTO" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Status atualizado com sucesso" },
          "401": { "description": "Não autenticado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } },
          "403": { "description": "Acesso proibido para perfil sem permissão", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } },
          "409": { "description": "Transição de status ilegal", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } }
        }
      }
    },
    "/fidelidade/extrato": {
      "get": {
        "tags": ["Fidelidade & LGPD"],
        "summary": "Consulta saldo de pontos de fidelidade do usuário autenticado",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Extrato de fidelidade" }
        }
      }
    },
    "/auditoria": {
      "get": {
        "tags": ["Auditoria"],
        "summary": "Consulta logs de auditoria transacional (Apenas ADMIN)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Logs recuperados com sucesso" },
          "403": { "description": "Apenas perfil ADMIN autorizado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Informe o token JWT no formato: Bearer <token>"
      }
    },
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "ESTOQUE_INSUFICIENTE" },
          "message": { "type": "string", "example": "Não há quantidade suficiente para um ou mais itens." },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": { "type": "string", "example": "itens[0].quantidade" },
                "issue": { "type": "string", "example": "Disponível em estoque: 1 unidade(s)" }
              }
            }
          },
          "timestamp": { "type": "string", "format": "date-time", "example": "2026-02-20T12:00:00Z" },
          "path": { "type": "string", "example": "/pedidos" },
          "requestId": { "type": "string", "example": "c4b8e920-7f21-4f1a-b6d4-399d2110ab78" }
        }
      }
    }
  }
}
